#!/bin/bash
# Lets the tests, which call the BSD form `script -q FILE COMMAND [ARG ...]`, run where `script` is
# the util-linux one (`script -q -c COMMAND FILE`). Put tests/shims first on PATH; nothing else
# changes, and on macOS it is not used.
quiet=
while [ "${1:-}" = "-q" ] || [ "${1:-}" = "-F" ] || [ "${1:-}" = "-a" ]; do
  [ "$1" = "-q" ] && quiet=1
  shift
done
file=$1
shift
cmd=
for word in "$@"; do
  cmd="$cmd $(printf '%q' "$word")"
done
exec /usr/bin/script -q -e -f -c "${cmd# }" "$file"
